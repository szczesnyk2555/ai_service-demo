{
  "Urls": "http://localhost:5080",
  "AllowedHosts": "*",

  "Storage": {
    // Relative paths are resolved against the application folder (content root).
    // Holds the SQLite database, uploaded drawings, logs and Data Protection keys.
    "DataDirectory": "App_Data"
  },

  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    // Default model used until a different one is chosen in Settings. Must be vision-capable.
    "DefaultModel": "gpt-6-astra",
    "SuggestedModels": [ "gpt-6-astra", "gpt-6-sol", "gpt-6-luna" ],
    "TimeoutSeconds": 180,
    "MaxOutputTokens": 16000,
    // Optional: "low" | "medium" | "high" for reasoning models. Leave empty to use the model default.
    "ReasoningEffort": ""
  },

  "Demo": {
    // Mock mode is on for a fresh install so the demo works without a key or network.
    "MockModeDefault": true,
    "MockDelaySeconds": 3,
    "Currency": "PLN"
  },

  "Upload": {
    "MaxSizeMb": 20
  },

  "Security": {
    // DPAPI scope used on Windows to encrypt the API key:
    //  "LocalMachine" - any process on this server can decrypt (works for both `dotnet run` and the service account)
    //  "CurrentUser"  - only the Windows account that saved the key can decrypt (stricter)
    "DpapiScope": "LocalMachine"
  }
}
