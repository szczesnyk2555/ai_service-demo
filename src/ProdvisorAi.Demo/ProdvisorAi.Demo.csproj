<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProdvisorAi.Demo</RootNamespace>
    <AssemblyName>ProdvisorAi.Demo</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <!-- Sample assets live in /samples (single source of truth).
       The canned mock responses are embedded; the sample drawing is copied next to the executable
       so the UI can offer a "use sample drawing" button. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\sample-mock-response.json" LogicalName="MockResponse.en.json" />
    <!-- WithCulture=false: otherwise MSBuild treats ".pl." as a culture and moves the file to a satellite assembly -->
    <EmbeddedResource Include="..\..\samples\sample-mock-response.pl.json" LogicalName="MockResponse.pl.json" WithCulture="false" />
    <None Include="..\..\samples\sample-drawing-shaft.png" Link="samples\sample-drawing-shaft.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
