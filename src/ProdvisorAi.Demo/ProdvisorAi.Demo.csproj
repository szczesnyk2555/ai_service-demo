<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProdvisorAi.Demo</RootNamespace>
    <AssemblyName>ProdvisorAi.Demo</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
    <PackageReference Include="Npgsql" Version="8.0.8" />
    <PackageReference Include="SkiaSharp" Version="4.153.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <!-- Sample assets live in /samples (single source of truth).
       The canned mock responses are embedded; the sample drawing is copied next to the executable
       so the UI can offer a "use sample drawing" button. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\sample-mock-response.json" LogicalName="MockResponse.json" />
    <!-- PRODVISOR master data snapshot (MASZYNY*, MaterialsKind): used when no database connection is configured -->
    <EmbeddedResource Include="..\..\samples\prodvisor-snapshot.json" LogicalName="ProdvisorSnapshot.json" />
    <EmbeddedResource Include="..\..\samples\prodvisor-snapshot-materials.json" LogicalName="ProdvisorSnapshotMaterials.json" />
    <None Include="..\..\samples\sample-drawing-shaft.png" Link="samples\sample-drawing-shaft.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\sample-drawing-shaft.dxf" Link="samples\sample-drawing-shaft.dxf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
